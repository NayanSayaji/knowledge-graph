{
  "manifest_version": 3,
  "name": "KnowlegeGraph",
  "short_name": "KnowlegeGraph",
  "description": "Turn everything you learn into a connected, searchable knowledge graph.",
  "version": "0.4.0",
  "permissions": ["activeTab", "storage", "contextMenus", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Save to KnowlegeGraph"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "knowlegegraph@knowlegegraph.dev",
      "strict_min_version": "121.0"
    }
  }
}
